<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parking_dark_end"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/parking_yellow"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_description"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/add_widget_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/parking_yellow"
            android:text="@string/add_widget"
            android:textColor="@color/parking_dark_end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/manual_add_instructions"
            android:textColor="@color/parking_yellow_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/open_dashboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/parking_yellow"
            android:text="@string/open_dashboard"
            android:textColor="@color/parking_dark_end" />
    </LinearLayout>
</ScrollView>

